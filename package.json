{
  "name": "@local/session-cleaner",
  "version": "1.0.0",
  "description": "删除会话与工作区分组，并清理对应日志、缓存及会话生成的文件。",
  "private": true,
  "type": "module",
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "backend.js", "artifacts.js", "verify-live.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-locale"]}}
}
